        { "to": "@complete", "when": { "type": "solace:objectives_complete" } }
      ]
    }
  ],
  "rewards": [
    { "id": "xp", "type": "solace:xp", "levels": 3 },
    { "id": "bread", "type": "solace:item", "item": "minecraft:bread", "count": 6 },
